<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Gateway API under launchd supervision (B3).
     User LaunchAgent for barry-agent: keychain (per-caller gateway-hmac-*
     secrets, db-url, anthropic-api-key) is only unlocked in a logged-in user
     session, so this cannot be a system LaunchDaemon — same constraint as the
     discord-bot job.
     Binds 127.0.0.1:8788 only; the public edge is the Cloudflare Tunnel
     (com.aiadaptive.cos.cloudflared), which routes the hostname -> this port.
     Needs the cognee + gateway groups synced:
       uv sync --group cognee --group gateway
     zsh -lc so uv resolves from the login PATH under launchd's bare env. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aiadaptive.cos.gateway</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/barry-agent/agents &amp;&amp; exec uv run python -m agents.gateway.app</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Relaunch on crash only. A clean exit (SIGTERM → uvicorn shutdown)
         must not fight the supervisor. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- uvicorn drains on SIGTERM; give it time before SIGKILL. -->
    <key>ExitTimeOut</key>
    <integer>20</integer>

    <key>StandardOutPath</key>
    <string>/Users/barry-agent/agents/logs/gateway.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/barry-agent/agents/logs/gateway.log</string>
</dict>
</plist>
