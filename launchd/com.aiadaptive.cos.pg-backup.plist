<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly pg_dump of aiadaptive_cos, 2:00 local (pulled forward from
     Phase 12 in the 2026-07 refactor proposal). The Postgres data dir is
     excluded from Time Machine; these dumps ARE the backup story. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aiadaptive.cos.pg-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/barry-agent/agents/scripts/pg_backup.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/barry-agent/agents/logs/pg-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/barry-agent/agents/logs/pg-backup.log</string>
</dict>
</plist>
